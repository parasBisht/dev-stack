# Absolute path to the folder that contains your projects (mounted at WORKDIR in every PHP container)
PROJECTS_PATH=/home/you/projects        # macOS e.g. /Users/you/code
WORKDIR=/var/www

# SSH agent forwarded into the PHP containers (composer over ssh).
# Linux: leave unset - your shell's SSH_AUTH_SOCK is used.
# macOS (Docker Desktop): uncomment the next line.
# SSH_AUTH_SOCK_HOST=/run/host-services/ssh-auth.sock

MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306

MEMCACHED_PORT=11211

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# MinIO image (optional profile). The official minio/minio image is no longer published.
# MINIO_IMAGE=cgr.dev/chainguard/minio:latest

NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

ADMINER_PORT=8081
ADMINER_DEFAULT_SERVER=mysql

PMA_HOST=mysql
PMA_PORT=3306
PMA_WEBPORT=8082
